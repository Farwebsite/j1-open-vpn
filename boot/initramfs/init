#!/bin/busybox sh
# SPDX-License-Identifier: GPL-2.0
# J1 Open VPN initramfs. Mounts the userdata partition and starts Alpine Linux
# from /data/j1-open-vpn/rootfs. On the first boot that folder does not exist
# yet: the system is unpacked from the HIDDEN partition, where it was flashed
# (as a raw .tar.gz) together with this boot image.
export PATH=/bin
BB=/bin/busybox
$BB mount -t proc proc /proc
$BB mount -t sysfs sysfs /sys
$BB mount -t tmpfs tmpfs /dev
$BB mknod /dev/console c 5 1
$BB mknod /dev/null c 1 3
$BB mknod /dev/urandom c 1 9
$BB mknod /dev/random c 1 8
$BB mknod /dev/kmsg c 1 11
$BB mkdir -p /dev/pts
$BB mount -t devpts devpts /dev/pts
$BB mdev -s
msg() { echo "J1 Open VPN: $*" >/dev/kmsg; }
fail() { msg "$*"; while :; do $BB sleep 60; done; }
# block device of a partition by its name in the partition table
part() {
 for d in /sys/class/block/mmcblk0p*; do
  $BB grep -qx "PARTNAME=$1" "$d/uevent" && { echo "/dev/${d##*/}"; return; }
 done
}
DATA=$(part userdata)
[ -n "$DATA" ] || fail 'userdata partition not found'
$BB mount -t ext4 -o nosuid,nodev,noatime "$DATA" /mnt/state || fail 'Cannot mount userdata'
BASE=/mnt/state/j1-open-vpn
ROOT=$BASE/rootfs
if [ ! -x "$ROOT/sbin/j1-init" ]; then
 SRC=$(part HIDDEN)
 [ -n "$SRC" ] || fail 'HIDDEN partition not found'
 # gzip magic: anything else means the system was not flashed to HIDDEN
 [ "$($BB head -c 2 "$SRC" | $BB od -An -tx1 | $BB tr -d ' \n')" = 1f8b ] ||
  fail 'No system in HIDDEN: flash j1-open-vpn-rootfs.tar.gz to the HIDDEN partition'
 msg 'first boot: unpacking the system from HIDDEN'
 $BB rm -rf "$BASE/rootfs.new"
 $BB mkdir -p "$BASE/rootfs.new"
 # the partition is bigger than the archive: gzip may complain about the
 # trailing zeros once tar has finished, so completeness is checked below
 $BB gzip -dc <"$SRC" 2>/dev/null | $BB tar -x -C "$BASE/rootfs.new"
 # the release marker is the last file of the archive
 [ -f "$BASE/rootfs.new/usr/share/j1/release" ] || fail 'The system in HIDDEN is incomplete: flash it again'
 $BB sync
 $BB rm -rf "$ROOT"
 $BB mv "$BASE/rootfs.new" "$ROOT" || fail 'Cannot install the system'
 $BB sync
 msg "installed $($BB cat "$ROOT/usr/share/j1/release")"
fi
$BB mount -o bind "$ROOT" /newroot || fail 'Cannot bind root filesystem'
$BB mkdir -p "$BASE/config" "$BASE/dropbear" /newroot/etc/j1 /newroot/etc/dropbear
$BB chmod 700 "$BASE" "$BASE/config" "$BASE/dropbear"
$BB mount -o bind "$BASE/config" /newroot/etc/j1 || fail 'Cannot bind configuration'
$BB mount -o bind "$BASE/dropbear" /newroot/etc/dropbear || fail 'Cannot bind SSH keys'
$BB umount /mnt/state
$BB mount -t tmpfs -o mode=755 tmpfs /newroot/run
$BB mount -t tmpfs -o mode=1777 tmpfs /newroot/tmp
$BB mount --move /proc /newroot/proc
$BB mount --move /sys /newroot/sys
$BB mount --move /dev /newroot/dev
exec $BB switch_root /newroot /sbin/j1-init
